{
  "name": "dayz-streamdeck",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.dayzserver.streamdeck\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "link": "streamdeck link com.dayzserver.streamdeck.sdPlugin",
    "restart": "streamdeck restart com.dayzserver.streamdeck",
    "validate": "streamdeck validate com.dayzserver.streamdeck.sdPlugin",
    "pack": "streamdeck pack com.dayzserver.streamdeck.sdPlugin --force",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "rollup": "^4.64.9",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
